# Cloudflare Pages response headers.

# Build output in /assets has content hashes in its file names: cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the page itself so new deploys show up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The examples are made at build time and have no hash in their names: revalidate them. So is the service worker, which has to be
# fetched fresh to find out that there is a new version.
/examples/*
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Other sites may embed the app (?embed=1 shows just the circuit), so framing is allowed everywhere: there is
# nothing to click-jack (no accounts, no backend).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; worker-src 'self'; connect-src 'self'; frame-ancestors *
