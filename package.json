{
  "name": "sklopko",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "oxlint",
    "check:bundle": "node scripts/check-bundle.mjs",
    "build:basic": "vitest run src/model/basic-build --mode build-basic",
    "api:dev": "wrangler dev --config api/wrangler.toml --port 8787",
    "api:migrate": "wrangler d1 migrations apply sklopko --local --config api/wrangler.toml",
    "api:migrate:remote": "wrangler d1 migrations apply sklopko --remote --config api/wrangler.toml"
  },
  "dependencies": {
    "immer": "^11.2.7",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261030.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "hono": "^4.13.14",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
